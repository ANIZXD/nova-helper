# Nova configuration — copy to .env and edit. All values are optional.

# --- Local AI gateway (OmniRoute, OpenAI-compatible) ---
OMNIROUTE_URL=http://127.0.0.1:20128/v1
# OmniRoute requires a key. If left blank, Nova reads the key from
# ~/.claude/settings.json (env.ANTHROPIC_AUTH_TOKEN).
OMNIROUTE_API_KEY=

# --- Models ---
# Must support function-calling. github/gpt-4o-mini is the reliable default.
# ddgw/* is keyless + $0 but rate-limited and unreliable at tool-calling.
NOVA_MODEL=github/gpt-4o-mini
NOVA_IMPROVER_MODEL=github/gpt-4o-mini

# --- Agent behaviour ---
NOVA_MAX_STEPS=12
NOVA_TEMPERATURE=0.2
# Require confirmation before medium/high risk tools (safe default: true).
NOVA_CONFIRM_RISKY=true
# Global preview mode: plan but never execute.
NOVA_DRY_RUN=false

# --- HTTP API (for your UI) ---
NOVA_API_HOST=127.0.0.1
NOVA_API_PORT=20129

# --- Optional binary overrides ---
# NOVA_OPENCODE=C:\path\to\opencode.exe
# NOVA_CLAUDE=C:\path\to\claude.exe
# NOVA_CODE=code
